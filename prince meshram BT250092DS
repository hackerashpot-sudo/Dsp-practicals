        fs.inorder(root)
    elif choice == "4":
        print("Preorder (Structure View):")
        fs.preorder(root)
    elif choice == "5":
        print("Postorder View:")
        fs.postorder(root)
    elif choice == "6":
        print("Exiting system...")
        break
    else:
        print("Invalid choice")
